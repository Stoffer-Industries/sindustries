# GymTrack — Identity + Supabase configuration
#
# VITE_* values are PUBLIC-by-design: Vite inlines them into the JS bundle at build time.
# The anon key is intended to be public; RLS policies are the gate.
#
# SUPABASE_SERVICE_ROLE_KEY is server-only. NEVER commit a real value.
# It is used only by Vercel/serverless API routes for privileged Supabase lookups.
#
# These values are provisioned by Quinn in Vercel project settings (not committed).
# Local dev: copy this file to `.env` and fill in values from Supabase project API settings.

# -----------------------------------------------------------------------------
# Supabase (data plane + legacy identity)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-a…here
VITE_GYMTRACK_MCP_BASE_URL=http://localhost:8787
SUPABASE_SERVICE_ROLE_KEY=your-s…here

# -----------------------------------------------------------------------------
# Identity provider switch (task bb09eaed, Phase 3 cutover)
# -----------------------------------------------------------------------------
# VITE_AUTH_PROVIDER selects which identity implementation AuthProvider
# mounts at app start. Default 'supabase' preserves the existing behaviour;
# flip to 'clerk' once Quinn has wired the Clerk instance, the Google
# OAuth re-registration, and the Supabase Third-Party Auth configuration
# documented in docs/specs/migrate-gymtrack-identity-supabase-auth-to-clerk-tech-design.md
# (Phase 0). The flag is read at build time by Vite — no runtime inspection.
#
#   'supabase' (default)  -> SupabaseAuthProvider  (current behaviour)
#   'clerk'               -> ClerkAuthProvider     (Phase 3 cutover)
#
# Rollback: set VITE_AUTH_PROVIDER=supabase and re-deploy. The Clerk
# branch is dormant, no Clerk SDK is mounted, and the existing Supabase
# session in localStorage remains valid until the user signs out.
VITE_AUTH_PROVIDER=supabase

# -----------------------------------------------------------------------------
# Clerk (browser-side only)
# -----------------------------------------------------------------------------
# VITE_CLERK_PUBLISHABLE_KEY is the Clerk publishable key (PUBLIC-by-design;
# Vite inlines it into the bundle). Required when VITE_AUTH_PROVIDER=clerk;
# ignored otherwise. Generate from the Clerk dashboard under "API Keys".
# Format: pk_test_<…> for development, pk_live_<…> for production.
VITE_CLERK_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Clerk server-side secret (NOT exposed to the browser)
# -----------------------------------------------------------------------------
# CLERK_SECRET_KEY is server-only. Used by services/gymtrack-mcp and any
# future server-side Clerk token introspection. NEVER prefix with VITE_ —
# the absence of the VITE_ prefix keeps it out of the browser bundle.
# Provisioned via `fly secrets set CLERK_SECRET_KEY=…` on the MCP deploy
# and via Vercel environment variables for any Vercel-side server code.
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# Browser error telemetry (task e89db27f)
# -----------------------------------------------------------------------------
# VITE_TELEMETRY_ENABLED is the explicit opt-in for production browser
# error reporting. The literal string '1' enables the global listeners
# in apps/gymtrack/src/lib/browserTelemetry.js; any other value (or
# unset) is a no-op so dev / preview / CI builds do not emit to staging.
# Quinn flips this on once the relay token is provisioned in Vercel.
VITE_TELEMETRY_ENABLED=

# VITE_TELEMETRY_TOKEN is the per-deploy shared token the browser uses
# to authenticate against apps/gymtrack/api/telemetry.js. The value
# must match the Vercel env var TELEMETRY_RELAY_TOKEN exactly. Quinn
# generates both at deploy time and rotates them together — rotation
# invalidates the in-flight build until the next deploy.
#
# This is a relay identifier, NOT an OAuth token — it has no user
# identity and cannot impersonate a user. It exists so the serverless
# function can reject events from arbitrary callers.
VITE_TELEMETRY_TOKEN=

# Optional: bake the deployed release tag into every telemetry event so
# the hosted Grafana dashboard can group by release. Defaults to 'dev'
# when unset. Quinn sets this at deploy time (e.g. via Vercel's
# deployment metadata).
VITE_RELEASE_TAG=

# -----------------------------------------------------------------------------
# Browser error telemetry — relay server-side (task e89db27f)
# -----------------------------------------------------------------------------
# Server-only. Set BOTH in the Vercel project env so api/telemetry.js can
# forward to the hosted Grafana.
#
# TELEMETRY_RELAY_TOKEN must match VITE_TELEMETRY_TOKEN above exactly.
# Generate a random value; it is a relay identifier, not a user credential.
#
# Handling: write the value into infra/cloud/observability/.env.local
# (mode 0600, excluded via .git/info/exclude) and read it from there when
# provisioning Vercel. Never commit it, and never paste it into a PR body,
# review, inline comment, task comment, or chat message — this repository is
# public and gitleaks does not scan comment bodies, so a pasted value leaks
# with a green check run.
TELEMETRY_RELAY_TOKEN=

# GRAFANA_CLOUD_OTLP_HEADERS is the server-held Basic auth over
# <instance_id>:<access_policy_token>. Never expose it to the browser —
# the absence of a VITE_ prefix keeps it out of the bundle.
#
# Use the SAME OTLP exporter header string format documented in
# infra/cloud/observability/env/.env.example, e.g.
#   GRAFANA_CLOUD_OTLP_HEADERS="Authorization=Basic <base64>"
# The relay parses that into real HTTP headers before calling Loki, so the
# "Authorization=" prefix is required (not part of the value). Several
# comma-separated pairs are supported, e.g.
#   "Authorization=Basic <base64>,X-Scope-OrgID=<id>"
GRAFANA_CLOUD_OTLP_HEADERS=

# GRAFANA_CLOUD_LOKI_ENDPOINT is the Loki HTTP push URL the relay posts
# to.
#
# REQUIRED on Grafana Cloud tenants: OTLP and the Loki push API are
# served from different hosts there (otlp-prod-<region>.grafana.net for
# OTLP, logs-prod-<stack>.grafana.net for Loki push). The relay's
# OTLP-derived fallback only works when one host serves both — on a
# multi-host tenant it would silently produce a 404 URL and the relay
# maps that to a dropped browser event. The relay now refuses the
# rewriter path on unrecognised shapes and surfaces a 502
# `misconfigured_loki_endpoint` with the operator-facing message
# `set GRAFANA_CLOUD_LOKI_ENDPOINT explicitly` instead of dropping the
# event silently — set this env var to keep AC4 evidence runs honest.
#
# Leave it unset only when the relay's rewriter is provably safe (a
# `/v1[-suffix]`-terminated OTLP base on a single-host deployment).
GRAFANA_CLOUD_LOKI_ENDPOINT=

# GRAFANA_CLOUD_OTLP_ENDPOINT is used as the fallback base for the
# push-URL derivation, and is the same endpoint the health-probe app
# already exports traces and metrics to. Acceptable values fall into
# two camps:
#   1. `/v1[-suffix]` shape (e.g. `https://otlp-<region>.grafana.net/v1/`
#      or `…/v1/logs`) — the rewriter will safely strip `/v1` and append
#      `/loki/api/v1/push`. Fits single-host setups.
#   2. Bare host (e.g. `https://otlp-<region>.grafana.net`) or any shape
#      that does NOT end in `/v1[-suffix]` — the rewriter returns null
#      and the relay returns 502 `misconfigured_loki_endpoint` until
#      `GRAFANA_CLOUD_LOKI_ENDPOINT` is set explicitly.
# This is the real shape on the prod Grafana Cloud tenant.
GRAFANA_CLOUD_OTLP_ENDPOINT=
