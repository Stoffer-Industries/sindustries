// Content Scheduler service Prisma schema.
//
// Owns the `content_scheduler` Postgres schema. The `ContentSchedulerItem`
// model + scheduler enums were extracted from `services/tasks-api` as part
// of task 94d5e4fc (extraction PR #2 in the series). The task/work/workflow
// domain remains in tasks-api's `tasks_api` schema; this service only
// owns Content Scheduler state.
//
// See docs/specs/content-scheduler-service-extraction-tech-design.md for
// the migration/backfill ownership story (3 migrations moved here from
// tasks-api/prisma/migrations/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentSchedulerItemStatus {
  draft
  queued
  approved
  published
  removed
}

enum ContentSchedulerSource {
  ops_notes
  cto_craft
  manual
  other
}

// Discriminates scheduled/auto-published items from manual-reply drafts
// (task 5279b310). A `manual_reply` row is created by the bookmark
// approval hook and is intentionally never auto-published: it surfaces in
// the Mission Control UI under "Reply drafts (manual)" for Tom to copy
// and post himself, with the resulting URL captured via
// PATCH /content-scheduler/items/:id/posted-url. Default `scheduled`
// preserves backwards compatibility for every existing row — no data
// migration needed.
enum ContentSchedulerItemKind {
  scheduled
  manual_reply
}

model ContentSchedulerItem {
  id                       String                       @id @default(uuid()) @db.Uuid
  body                     String                       @db.VarChar(1000)
  source                   ContentSchedulerSource       @default(manual)
  sourceRef                String?
  status                   ContentSchedulerItemStatus   @default(queued)
  scheduledFor             DateTime?
  position                 Int                          @default(0)
  approvedAt               DateTime?
  approvedBy               String?
  publishedAt              DateTime?
  publishedUrl             String?
  publishError             String?
  autoPostJobId            String?
  autoPostScheduleVersion  Int                          @default(0)
  autoPostScheduledAt      DateTime?
  autoPostLastEnqueuedAt   DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  removedAt                DateTime?

  // Manual-reply draft metadata (task 5279b310). Null for ordinary
  // scheduled items.
  kind                 ContentSchedulerItemKind @default(scheduled)
  manualPostedUrl      String?
  manualPostedAt       DateTime?
  // Cross-link from a manual_reply item to its standalone "build in
  // public" tweet item. Renamed from `linksToDraftId` to match the
  // post-extraction `items/` terminology (the standalone tweet is also
  // a ContentSchedulerItem, not a separate draft entity).
  linksToItemId        String?

  @@index([status, position])
  @@index([status, scheduledFor])
  @@index([status, publishedAt])
  @@index([kind])
}