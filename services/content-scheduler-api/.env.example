# content-scheduler-api — local development env contract.
#
# Copy to .env for local dev; values here are validated at boot by
# services/content-scheduler-api/src/config/env.ts.
#
# Task: 94d5e4fc-1b31-4d04-a13b-4f69a7ec297a (Extract Content Scheduler from Tasks API)
# Tech design: docs/specs/content-scheduler-service-extraction-tech-design.md

# Copy to .env for local development
# Required in production
# Owner: platform (Quinn)
# Rotation: per-deploy
PORT=4003

# Local Postgres example (dev mode default).
# Content Scheduler shares the same Postgres database as tasks-api during
# the migration window; the data lives in its own schema. After the
# extraction ships, this points to the content-scheduler-owned schema.
# Required in production
# Owner: Rowan
# Rotation: 90d or on-incident
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/sindustries_dev?schema=content_scheduler"

# Comma-separated explicit allowlist for browser origins.
# Defaults to local dev origins if unset.
# Required in production
# Owner: Rowan
# Rotation: per-deploy
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5175,http://localhost:5176"

# Rate limit window for write endpoints (AC1 / AC2).
# Required in production
# Owner: Rowan
# Rotation: per-deploy
CONTENT_SCHEDULER_API_RATE_LIMIT_WINDOW_MS=60000
CONTENT_SCHEDULER_API_RATE_LIMIT_MAX=120

# Service credentials for the user-facing mutation surface
# (POST/PATCH/DELETE /api/v1/content-scheduler/items*). Parsed as a JSON
# array of { token, actor, approvalTypes } at module load with fail-fast
# semantics on malformed input. Optional: when unset or [], the
# requireAuthenticatedUser middleware in src/middleware/requireAuth.ts is
# pass-through (matches the Phase-1 trade-off in
# docs/specs/content-scheduler-auth-tech-design.md — the HTTP service is
# not Fly-deployed today, so this is latent per repo-audit-2026-W36 A1).
#
# Required in production (Phase 1 minimum: at least one populated credential
# so browser-driven write paths do not 401 the moment the middleware lands).
# Owner: Rowan
# Rotation: 90d or on-incident
CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS='[{"token":"replace-me-with-openssl-rand-hex-32","actor":"tasks_app_browser","approvalTypes":["any"]}]'
