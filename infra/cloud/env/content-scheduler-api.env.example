# content-scheduler-api — staging Fly secrets contract.
#
# This file documents the env vars that infra/cloud/scripts/bootstrap-staging.sh
# reads from .env.local and applies to the ONE consolidated staging Fly app,
# `sindustries-platform-staging`, which carries tasks-api, budget-api,
# content-scheduler-api and the auto-post worker as four processes inside a
# single Machine (task 219fb673). Each key in this file is PREFIXED by
# `CONTENT_SCHEDULER_API_` in .env.local.
#
# The per-service staging apps (sindustries-tasks-api-staging,
# sindustries-budget-api-staging, sindustries-content-scheduler-api-staging,
# sindustries-auto-post-worker-staging) were destroyed at the 2026-11-07
# cutover, and the bootstrap script refuses to recreate them — staging is one
# app now. This file still lists the env vars the content-scheduler API
# itself reads, which the consolidation did not change; the app-level
# `PLATFORM_*` secret names are in infra/cloud/env/platform.env.example, and
# the supervisor (infra/cloud/platform/platform-supervisor.mjs) maps those
# onto the child's own variable names (DATABASE_URL, REDIS_URL,
# CONTENT_SCHEDULER_REDIS_URL, CORS_ALLOWED_ORIGINS).
#
# Operator-facing reference (per-key owner + rotation + failure mode):
#   ~/.openclaw/workspace/docs/infra/runbooks/production-runtime-config.md
# Tech design + verification matrix:
#   docs/specs/cloud-readiness-production-runtime-configuration-tech-design.md
#   docs/specs/cloud-deployment-foundation-tech-design.md (PR #508 APPROVED)
#
# Owner column maps each key to: Quinn / Rowan / Tom. Quinn-owned values are
# registered into .env.local out-of-band and never committed.
#
# This file does NOT include every key the content-scheduler API reads at
# boot — only the cloud-relevant subset. For the full local-dev contract
# (including CONTENT_SCHEDULER_API_RATE_LIMIT_*), see
# services/content-scheduler-api/.env.example.

# Required. Must target the content_scheduler schema and match the worker DB.
CONTENT_SCHEDULER_API_DATABASE_URL=

# Required for the BullMQ adapter. These should match the worker queue.
CONTENT_SCHEDULER_API_REDIS_URL=
CONTENT_SCHEDULER_API_CONTENT_SCHEDULER_REDIS_URL=

# Required before exposing the HTTP mutation surface. JSON array of
# {"token":"...","actor":"...","approvalTypes":["any"]}.
CONTENT_SCHEDULER_API_CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS=

# Staging validates API contracts without publishing live posts.
CONTENT_SCHEDULER_API_X_CLIENT=fake

CONTENT_SCHEDULER_API_OTEL_SERVICE_NAME=content-scheduler-api
CONTENT_SCHEDULER_API_OTEL_SERVICE_NAMESPACE=sindustries
CONTENT_SCHEDULER_API_OTEL_ENVIRONMENT=staging
