# content-scheduler-api — staging Fly secrets contract.
# Values are supplied through infra/cloud/.env.local with the
# CONTENT_SCHEDULER_API_ prefix; bootstrap-staging.sh strips that prefix.

# Required. Must target the content_scheduler schema and match the worker DB.
CONTENT_SCHEDULER_API_DATABASE_URL=

# Required for the BullMQ adapter. These should match the worker queue.
CONTENT_SCHEDULER_API_REDIS_URL=
CONTENT_SCHEDULER_API_CONTENT_SCHEDULER_REDIS_URL=

# Required before exposing the HTTP mutation surface. JSON array of
# {"token":"...","actor":"...","approvalTypes":["any"]}.
CONTENT_SCHEDULER_API_CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS=

# Staging validates API contracts without publishing live posts.
CONTENT_SCHEDULER_API_X_CLIENT=fake

CONTENT_SCHEDULER_API_OTEL_SERVICE_NAME=content-scheduler-api
CONTENT_SCHEDULER_API_OTEL_SERVICE_NAMESPACE=sindustries
CONTENT_SCHEDULER_API_OTEL_ENVIRONMENT=staging
