# bootstrap-production.env.example — the SOURCE contract consumed by
# infra/cloud/scripts/bootstrap-production.sh.
#
# WHY THIS FILE EXISTS (and why it is NOT platform.env.example)
# ==============================================================
# `infra/cloud/env/platform.env.example` documents the DESTINATION names:
# the app-level `PLATFORM_*` Fly secrets on the consolidated app. That is
# the CI contract — the deploy workflow maps the environment secrets onto
# those names and writes them directly.
#
# `infra/cloud/scripts/bootstrap-production.sh` is the LOCAL operator path.
# It does not write `PLATFORM_*` secrets itself: the platform provisioner
# (infra/cloud/platform/platform-provision-secrets.mjs) owns that mapping,
# so a local bootstrap and a CI deploy can never register different secrets
# on the same app. The script therefore reads the provisioner's SOURCE
# names and translates them.
#
# So the two files document DIFFERENT ends of the same mapping:
#
#   this file (source names)          ->  provisioner  ->  platform.env.example
#   (destination names)
#
# Copy THIS file to infra/cloud/.env.production.local, fill in the values,
# and run:
#
#   infra/cloud/scripts/bootstrap-production.sh --yes
#
# .env.production.local is gitignored. Never commit real values.
#
# ---------------------------------------------------------------------------
# THE EXACT SOURCE CONTRACT
# ---------------------------------------------------------------------------
# The source NAMES are owned by the environment manifest
# (infra/cloud/platform/platform-environments.mjs). The local keys below
# are translated into them:
#
#   TASKS_API_DATABASE_URL                             -> PRODUCTION_TASKS_API_DATABASE_URL
#   BUDGET_API_DATABASE_URL                            -> PRODUCTION_BUDGET_API_DATABASE_URL
#   AUTO_POST_WORKER_DATABASE_URL                      -> PRODUCTION_CONTENT_SCHEDULER_API_DATABASE_URL
#   HEALTH_PROBE_REDIS (or TASKS_API_CONTENT_SCHEDULER_REDIS_URL) -> PRODUCTION_HEALTH_PROBE_REDIS
#   TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN       -> PRODUCTION_TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#   CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN -> PRODUCTION_CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#
# REQUIRED (the script fails closed, before it touches Fly, when one is
# missing, and names the missing source on stderr):
#
#   TASKS_API_DATABASE_URL
#   BUDGET_API_DATABASE_URL
#   HEALTH_PROBE_REDIS                (or TASKS_API_CONTENT_SCHEDULER_REDIS_URL)
#   TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#   CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#
# OPTIONAL:
#
#   AUTO_POST_WORKER_DATABASE_URL — only needed when the content-scheduler
#                        schema lives on its OWN database. On the approved
#                        topology it lives in the same database as
#                        tasks_api, and the provisioner then derives
#                        PLATFORM_CONTENT_SCHEDULER_API_DATABASE_URL from
#                        the tasks-api DSN.
#
#   FLY_APP_ORG        — the Fly organization (default: personal, or the
#                        value of PRODUCTION_FLY_ORG when it is exported).
#                        The Fly ORG is overridable; the Fly APP NAME IS
#                        NOT: production is one app,
#                        sindustries-platform-production. Any other app
#                        name is refused before the first Fly call.
#
# ---------------------------------------------------------------------------
# VALUES
# ---------------------------------------------------------------------------
# DATABASE — one per schema (one Neon production database, three schemas).
# Owner: Quinn (Neon production connection strings).
# Rotation: 90d or on-incident.
# Format: postgresql://<user>:***@<neon-host>/<db>?schema=<schema>&sslmode=require
#
# The content-scheduler API and the auto-post worker share one schema, so
# they take the SAME value here.
#
# PRODUCTION VALUES ARE REFUSED WHEN THEY LOOK LIKE STAGING. The
# provisioner scans every value for staging/dev hostnames, placeholders and
# localhost, and refuses the whole payload before it touches Fly. A
# production value that still carries a staging marker is a bug in the
# source, not something to work around.
TASKS_API_DATABASE_URL=
BUDGET_API_DATABASE_URL=
AUTO_POST_WORKER_DATABASE_URL=

# REDIS — the live production instance.
# Owner: Quinn (Upstash production, TLS).
# Rotation: per-deploy.
#
# REDIS CAVEAT: this must be the LIVE production instance. A URL pointing
# at a deleted instance still parses as a redis:// URL, so the provisioner's
# shape check passes; only the supervisor's first queue operation would
# fail. Verify the instance answers before bootstrapping.
HEALTH_PROBE_REDIS=

# APPROVAL SERVICE CREDENTIALS — one token per approving service.
# Owner: Quinn.
# Rotation: per-deploy.
#
# The production approval actor (`production-cloud-validate`) is
# deliberately NOT in the Tasks API APPROVAL_ACTOR map: it can use the
# ordinary authenticated mutation routes, and every approval-row route
# fails closed with 403 APPROVAL_ACTOR_FORBIDDEN.
TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN=
CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN=

# Optional: the Fly organization that owns the production app.
# FLY_APP_ORG=personal
