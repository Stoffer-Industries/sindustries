# bootstrap-staging.env.example — the SOURCE contract consumed by
# infra/cloud/scripts/bootstrap-staging.sh.
#
# WHY THIS FILE EXISTS (and why it is NOT platform.env.example)
# ==============================================================
# `infra/cloud/env/platform.env.example` documents the DESTINATION names:
# the app-level `PLATFORM_*` Fly secrets on the consolidated app. That is
# the CI contract — the deploy workflow maps the staging GitHub
# environment secrets onto those names and writes them directly.
#
# `infra/cloud/scripts/bootstrap-staging.sh` is the LOCAL operator path.
# It does not write `PLATFORM_*` secrets itself: the platform provisioner
# (infra/cloud/platform/platform-provision-secrets.mjs) owns that
# mapping, so a local bootstrap and a CI deploy can never register
# different secrets on the same app. The script therefore reads the
# provisioner's SOURCE names and translates them.
#
# So the two files document DIFFERENT ends of the same mapping:
#
#   this file (source names)          ->  provisioner  ->  platform.env.example
#   (destination names)
#
# Copy THIS file to infra/cloud/.env.local, fill in the Quinn-owned
# values, and run:
#
#   infra/cloud/scripts/bootstrap-staging.sh --yes
#
# .env.local is gitignored. Never commit real values.
#
# Owner column maps each key to: Quinn / Rowan / Tom. Quinn-owned values
# are registered out-of-band and never committed.
#
# ---------------------------------------------------------------------------
# THE EXACT SOURCE CONTRACT
# ---------------------------------------------------------------------------
# These six keys are REQUIRED. The script fails closed (before it touches
# Fly) when any of them is missing, and names the missing one on stderr.
#
#   TASKS_API_DATABASE_URL
#   BUDGET_API_DATABASE_URL
#   AUTO_POST_WORKER_DATABASE_URL
#   HEALTH_PROBE_REDIS                (or TASKS_API_CONTENT_SCHEDULER_REDIS_URL)
#   TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#   CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#
# The translation the script applies (source name -> provisioner source):
#
#   TASKS_API_DATABASE_URL                             -> STAGING_TASKS_API_DATABASE_URL
#   BUDGET_API_DATABASE_URL                            -> STAGING_BUDGET_API_DATABASE_URL
#   AUTO_POST_WORKER_DATABASE_URL                      -> STAGING_CONTENT_SCHEDULER_API_DATABASE_URL
#   HEALTH_PROBE_REDIS (or TASKS_API_CONTENT_SCHEDULER_REDIS_URL) -> HEALTH_PROBE_REDIS
#   TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN       -> TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#   CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN -> CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN
#
# OPTIONAL:
#
#   FLY_APP_ORG        — the Fly organization (default: personal). The Fly
#                        ORG is overridable; the Fly APP NAME IS NOT.
#                        Staging is one app: sindustries-platform-staging.
#                        Any other app name is refused before the first Fly
#                        call, because the retired per-service staging apps
#                        must not be recreated.
#
# ---------------------------------------------------------------------------
# VALUES
# ---------------------------------------------------------------------------
# DATABASE — one per schema (one Neon database, three schemas).
# Owner: Quinn (Neon staging connection strings).
# Rotation: 90d or on-incident.
# Format: postgresql://<user>:***@<neon-host>/<db>?schema=<schema>&sslmode=require
#
# The content-scheduler API and the auto-post worker share one schema, so
# they take the SAME value here.
TASKS_API_DATABASE_URL=
BUDGET_API_DATABASE_URL=
AUTO_POST_WORKER_DATABASE_URL=

# REDIS — the live staging instance.
# Owner: Quinn (Upstash staging, TLS).
# Rotation: per-deploy.
#
# REDIS CAVEAT: this must be the LIVE staging instance. A URL pointing at
# a deleted instance still parses as a redis:// URL, so the provisioner's
# shape check passes; only the supervisor's first queue operation would
# fail. Verify the instance answers before bootstrapping.
HEALTH_PROBE_REDIS=

# APPROVAL SERVICE CREDENTIALS — one token per approving service.
# Owner: Quinn.
# Rotation: per-deploy.
TASKS_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN=
CONTENT_SCHEDULER_API_APPROVAL_SERVICE_CREDENTIALS_TOKEN=

# Optional: the Fly organization that owns the staging app.
# FLY_APP_ORG=personal
