# auto-post-worker — staging Fly secrets contract.
#
# This file documents the env vars that infra/cloud/scripts/bootstrap-staging.sh
# reads from .env.local and applies to the sindustries-auto-post-worker-staging
# Fly app via `fly secrets set`. Each key in this file is PREFIXED by
# `AUTO_POST_WORKER_` in .env.local so the same naming pattern works for
# tasks-api and budget-api. The bootstrap script strips the prefix when
# calling `fly secrets set` (AUTO_POST_WORKER_DATABASE_URL -> DATABASE_URL on
# the Fly app).
#
# Operator-facing reference (per-key owner + rotation + failure mode):
#   docs/runbooks/production-runtime-config.md
# Tech design + verification matrix:
#   docs/specs/cloud-deployment-foundation-tech-design.md (PR #508 APPROVED)
# Worker source: services/content-scheduler-api/src/workers/autoPostWorkerMain.ts
#
# Owner column maps each key to: Quinn / Rowan / Tom. Quinn-owned values are
# registered into .env.local out-of-band and never committed.
#
# The worker is a NON-HTTP service (no [http_service] in fly.toml). It runs
# BullMQ job dispatch against the Redis queue. Secrets it reads are the
# minimum needed for that path; UI-facing concerns (CORS, approval auth)
# are NOT in the worker's contract.
#
# This file does NOT include every key the worker entrypoint touches — only
# the cloud-relevant subset. For the full local-dev contract, see
# services/content-scheduler-api/.env.example.

# ============================================================================
# DATABASE
# ============================================================================
# Required in production.
# Owner: Quinn (Neon staging DATABASE_URL — content_scheduler schema).
# Rotation: 90d or on-incident.
# Format: postgresql://<user>:<password>@<neon-host>/<db>?schema=content_scheduler&sslmode=require
AUTO_POST_WORKER_DATABASE_URL=

# ============================================================================
# BullMQ queue (Quinn-owned; Upstash staging)
# ============================================================================
# Required in production.
# Owner: Quinn (Upstash staging REDIS_URL — TLS, separate from local dev).
# Rotation: per-deploy.
#
# The worker ENQUEUES by reading CONTENT_SCHEDULER_API_BASE_URL (used for the
# reconciliation sweep that re-publishes overdue approved items). It does NOT
# use the API as a proxy — it talks to Prisma + BullMQ directly.
AUTO_POST_WORKER_CONTENT_SCHEDULER_API_BASE_URL=https://sindustries-content-scheduler-api-staging.fly.dev/api/v1

# Required in production. Must agree with the API's value so they enqueue/consume
# against the same queue. The worker's Fly [env] already pins JOB_ADAPTER=bullmq;
# .env.local is the source of truth for REDIS_URL.
AUTO_POST_WORKER_REDIS_URL=
AUTO_POST_WORKER_CONTENT_SCHEDULER_REDIS_URL=

# ============================================================================
# X (Twitter) — required for live publishing
# ============================================================================
# Required in production. The worker IS the auto-post path (BullMQ job -> X
# API). It uses the SAME OAuth 1.0a credentials as tasks-api's manual publish
# route, but the worker reads them locally rather than calling the API.
#
# Owner: Rowan.
# Rotation: per-deploy.
AUTO_POST_WORKER_X_CLIENT=real
AUTO_POST_WORKER_X_HANDLE=sindustries

# Required when X_CLIENT=real.
# Owner: Rowan.
# Rotation: per-deploy.
AUTO_POST_WORKER_X_API_KEY=
AUTO_POST_WORKER_X_API_SECRET=
AUTO_POST_WORKER_X_ACCESS_TOKEN=
AUTO_POST_WORKER_X_ACCESS_TOKEN_SECRET=

# ============================================================================
# OpenTelemetry (passed through to @sindustries/otel-node)
# ============================================================================
# Required in production (collected by the staging observability collector).
# Owner: Quinn (collector endpoint) / Rowan (service-level tags).
# Rotation: per-deploy.
AUTO_POST_WORKER_OTEL_SERVICE_NAME=auto-post-worker
AUTO_POST_WORKER_OTEL_SERVICE_NAMESPACE=sindustries
AUTO_POST_WORKER_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging.svc:4318
AUTO_POST_WORKER_OTEL_TRACES_EXPORTER=otlp
AUTO_POST_WORKER_OTEL_METRICS_EXPORTER=otlp
AUTO_POST_WORKER_OTEL_LOGS_EXPORTER=none
AUTO_POST_WORKER_OTEL_ENVIRONMENT=staging