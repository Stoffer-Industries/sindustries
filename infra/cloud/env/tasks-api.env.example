# tasks-api — staging Fly secrets contract.
#
# This file documents the env vars that infra/cloud/scripts/bootstrap-staging.sh
# reads from .env.local and applies to the sindustries-tasks-api-staging Fly
# app via `fly secrets set`. Each key in this file is PREFIXED by `TASKS_API_`
# in .env.local so the same naming pattern works for budget-api and
# auto-post-worker. The bootstrap script strips the prefix when calling
# `fly secrets set` (TASKS_API_DATABASE_URL -> DATABASE_URL on the Fly app).
#
# Operator-facing reference (per-key owner + rotation + failure mode):
#   docs/runbooks/production-runtime-config.md
# Tech design + verification matrix:
#   docs/specs/cloud-readiness-production-runtime-configuration-tech-design.md
#   docs/specs/cloud-deployment-foundation-tech-design.md (PR #508 APPROVED)
#
# Owner column maps each key to: Quinn / Rowan / Tom. Quinn-owned values are
# registered into .env.local out-of-band and never committed.
#
# This file does NOT include every key the tasks-api reads at boot — only the
# cloud-relevant subset. For the full local-dev contract (including
# TASKS_API_APPROVAL_USERS etc.), see services/tasks-api/.env.example.

# Source-of-truth contract for the local-dev env:
# services/tasks-api/.env.example
# This staging file inherits from that. Keys NOT applicable to staging:
#   - TASKS_API_APPROVAL_USERS — Quinn-supplied via runtime config (task 206927ed)
#   - DEV_* — staging is not local dev

# ============================================================================
# DATABASE
# ============================================================================
# Required in production.
# Owner: Quinn (Neon staging DATABASE_URL — separate from local dev data).
# Rotation: 90d or on-incident.
# Format: postgresql://<user>:<password>@<neon-host>/<db>?schema=tasks_api&sslmode=require
TASKS_API_DATABASE_URL=

# ============================================================================
# Content Scheduler cross-service wiring (task 94d5e4fc extraction)
# ============================================================================
# Required in production.
# Owner: Quinn (URL points to the content-scheduler-api Fly app).
# Rotation: per-deploy.
TASKS_API_CONTENT_SCHEDULER_API_BASE_URL=https://sindustries-content-scheduler-api-staging.fly.dev/api/v1

# BullMQ adapter values (task 1945f8a2). Both API and worker MUST agree.
# Owner: Quinn (Upstash staging REDIS_URL — TLS, separate from local dev).
# Rotation: per-deploy.
# CONTENT_SCHEDULER_JOB_ADAPTER is set in the Fly [env] section of the
# auto-post-worker.fly.toml (= bullmq); the API can read either REDIS_URL
# or CONTENT_SCHEDULER_REDIS_URL — the API defaults to REDIS_URL.
TASKS_API_CONTENT_SCHEDULER_JOB_ADAPTER=bullmq
TASKS_API_CONTENT_SCHEDULER_REDIS_URL=
TASKS_API_REDIS_URL=

# ============================================================================
# Approval auth (task 206927ed follow-up)
# ============================================================================
# Required in production.
# Owner: Tom (TASKS_API_APPROVAL_USERS list) / Rowan (TASKS_API_APPROVAL_SERVICE_CREDENTIALS).
# Rotation: on-incident / 90d.
TASKS_API_TASKS_API_APPROVAL_USERS=[]
TASKS_API_TASKS_API_APPROVAL_SERVICE_CREDENTIALS=[]
TASKS_API_TASKS_API_APPROVAL_SESSION_TTL_SECONDS=28800

# ============================================================================
# Cross-cutting
# ============================================================================
# Required in production.
# Owner: Rowan.
# Rotation: per-deploy.
TASKS_API_CORS_ALLOWED_ORIGINS=https://mission-control.sindustries.dev

# Required in production.
# Owner: Rowan (X client is `real` in production, `fake` in dev/test).
# Rotation: per-deploy.
TASKS_API_X_CLIENT=real
TASKS_API_X_HANDLE=sindustries

# Required when X_CLIENT=real.
# Owner: Rowan (OAuth 1.0a credentials).
# Rotation: per-deploy.
TASKS_API_X_API_KEY=
TASKS_API_X_API_SECRET=
TASKS_API_X_ACCESS_TOKEN=
TASKS_API_X_ACCESS_TOKEN_SECRET=

# Cloud-readiness gate (task 38d2ee65) for POST /content-scheduler/items/:id/publish.
# Required when X_CLIENT=real in cloud deploys.
# Owner: Rowan. Rotation: 90d or on-incident.
# Generate with: openssl rand -hex 32
TASKS_API_X_ACTOR_SECRET=

# Trusted internal batch import gate (task 9dfe56e4) for POST /content-scheduler/imports/cto-craft.
# Required in cloud deploys; recommended when the CTO Craft LangGraph workflow is wired up.
# Owner: Rowan. Rotation: 90d or on-incident.
# Generate with: openssl rand -hex 32
TASKS_API_CONTENT_SCHEDULER_INGEST_SECRET=

# ============================================================================
# OpenTelemetry (passed through to @sindustries/otel-node)
# ============================================================================
# Required in production (collected by the staging observability collector).
# Owner: Quinn (collector endpoint) / Rowan (service-level tags).
# Rotation: per-deploy.
TASKS_API_OTEL_SERVICE_NAME=tasks-api
TASKS_API_OTEL_SERVICE_NAMESPACE=sindustries
TASKS_API_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging.svc:4318
TASKS_API_OTEL_TRACES_EXPORTER=otlp
TASKS_API_OTEL_METRICS_EXPORTER=otlp
TASKS_API_OTEL_LOGS_EXPORTER=none
TASKS_API_OTEL_ENVIRONMENT=staging

# ============================================================================
# HTTP hardening (cloud-safe defaults; same as local)
# ============================================================================
# Owner: Rowan.
# Rotation: manual.
TASKS_API_TASKS_API_JSON_LIMIT=100kb
TASKS_API_TASKS_API_RATE_LIMIT_WINDOW_MS=900000
TASKS_API_TASKS_API_RATE_LIMIT_MAX=100