# budget-api — staging Fly secrets contract.
#
# This file documents the env vars that infra/cloud/scripts/bootstrap-staging.sh
# reads from .env.local and applies to the sindustries-budget-api-staging Fly
# app via `fly secrets set`. Each key in this file is PREFIXED by `BUDGET_API_`
# in .env.local so the same naming pattern works for tasks-api and
# auto-post-worker. The bootstrap script strips the prefix when calling
# `fly secrets set` (BUDGET_API_DATABASE_URL -> DATABASE_URL on the Fly app).
#
# Operator-facing reference (per-key owner + rotation + failure mode):
#   docs/runbooks/production-runtime-config.md
# Tech design + verification matrix:
#   docs/specs/cloud-readiness-production-runtime-configuration-tech-design.md
#   docs/specs/cloud-deployment-foundation-tech-design.md (PR #508 APPROVED)
#
# Owner column maps each key to: Quinn / Rowan / Tom. Quinn-owned values are
# registered into .env.local out-of-band and never committed.
#
# This file does NOT include every key the budget-api reads at boot — only the
# cloud-relevant subset. For the full local-dev contract (including
# AKAHU_DEV_USER_ACCESS_TOKEN, BUDGET_API_TOKEN_KEY, etc.), see
# services/budget-api/.env.example.

# ============================================================================
# DATABASE
# ============================================================================
# Required in production.
# Owner: Quinn (Neon staging DATABASE_URL — separate from local dev data).
# Rotation: 90d or on-incident.
# Format: postgresql://<user>:<password>@<neon-host>/<db>?schema=budget_api&sslmode=require
BUDGET_API_DATABASE_URL=

# ============================================================================
# Session + encryption keys
# ============================================================================
# Required in production.
# Owner: Rowan.
# Rotation: 90d.
# The placeholder `dev-secret-change-me` is rejected in production by the
# budget-api config schema (task 206927ed follow-up).
BUDGET_API_DEV_SESSION_SECRET=

# Required in production. AES-256-GCM key for at-rest encryption of Akahu
# access tokens. Loss of this key = every stored Akahu token is unrecoverable.
# Owner: Rowan.
# Rotation: 90d or on-incident.
# Generate with: openssl rand -hex 32
BUDGET_API_BUDGET_API_TOKEN_KEY=

# ============================================================================
# Akahu (server-side)
# ============================================================================
# Required in production.
# Owner: Rowan (Akahu app credentials — bank-link OAuth client).
# Rotation: AKAHU_CLIENT_SECRET 90d or on-incident; rest per-deploy.
BUDGET_API_AKAHU_CLIENT_ID=
BUDGET_API_AKAHU_CLIENT_SECRET=
BUDGET_API_AKAHU_REDIRECT_URI=https://mission-control.sindustries.dev/api/v1/akahu/callback

# ============================================================================
# Email (optional, only if email features are enabled in staging)
# ============================================================================
# Required in production IF email features are enabled.
# Owner: Rowan.
# Rotation: per-deploy / 90d.
BUDGET_API_EMAIL_FROM=
BUDGET_API_EMAIL_PROVIDER_API_KEY=

# ============================================================================
# Push — APNs (optional, only if push features are enabled in staging)
# ============================================================================
# Required in production IF push features are enabled.
# Owner: Rowan.
# Rotation: per-deploy / 90d.
BUDGET_API_APNS_KEY_ID=
BUDGET_API_APNS_TEAM_ID=
BUDGET_API_APNS_BUNDLE_ID=
BUDGET_API_APNS_PRIVATE_KEY_P8=

# ============================================================================
# LLM (optional, only if LLM features are enabled in staging)
# ============================================================================
# Required in production IF LLM features are enabled.
# Owner: Rowan.
# Rotation: per-deploy / 90d.
BUDGET_API_LLM_PROVIDER=openai
BUDGET_API_LLM_API_KEY=

# ============================================================================
# Cross-cutting
# ============================================================================
# Required in production.
# Owner: Rowan.
# Rotation: per-deploy.
BUDGET_API_CORS_ALLOWED_ORIGINS=https://mission-control.sindustries.dev

# ============================================================================
# OpenTelemetry (passed through to @sindustries/otel-node)
# ============================================================================
# Required in production (collected by the staging observability collector).
# Owner: Quinn (collector endpoint) / Rowan (service-level tags).
# Rotation: per-deploy.
BUDGET_API_OTEL_SERVICE_NAME=budget-api
BUDGET_API_OTEL_SERVICE_NAMESPACE=sindustries
BUDGET_API_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging.svc:4318
BUDGET_API_OTEL_TRACES_EXPORTER=otlp
BUDGET_API_OTEL_METRICS_EXPORTER=otlp
BUDGET_API_OTEL_LOGS_EXPORTER=none
BUDGET_API_OTEL_ENVIRONMENT=staging

# ============================================================================
# HTTP hardening (cloud-safe defaults; same as local)
# ============================================================================
# Owner: Rowan.
# Rotation: manual.
BUDGET_API_BUDGET_API_JSON_LIMIT=100kb
BUDGET_API_BUDGET_API_RATE_LIMIT_WINDOW_MS=900000
BUDGET_API_BUDGET_API_RATE_LIMIT_MAX=100