# mission-control.env.example — staging build-time env.
#
# These are passed to `fly deploy` as `--build-arg`, NOT as runtime env
# vars. Vite inlines `import.meta.env.*` references at build time, so
# these values are baked into the SPA bundle. Changing them requires a
# rebuild + redeploy.
#
# Usage:
#   fly deploy \
#     --config infra/cloud/fly/mission-control.fly.toml \
#     --build-arg VITE_TASKS_API_BASE_URL=$(awk -F= '/^VITE_TASKS_API_BASE_URL/{print $2}' infra/cloud/env/mission-control.env.example) \
#     --build-arg VITE_TASKS_APP_URL=$(awk -F= '/^VITE_TASKS_APP_URL/{print $2}' infra/cloud/env/mission-control.env.example)
#
# Sourcing these directly in CI as `--build-arg VITE_X=$VITE_X` works too.

# Staging Tasks API base URL — read by apps/mission-control/src/tasksApi.js
# and apps/mission-control/src/contentSchedulerApi.js to fetch Tasks, Flow
# Metrics, Content Scheduler, and bookmark pipeline views.
VITE_TASKS_API_BASE_URL=https://sindustries-tasks-api-staging.fly.dev/api/v1

# Staging Tasks app URL — read by apps/mission-control/src/tabs/TasksTab.jsx
# for the iframe `src`. Must be the tasks-app Fly deployment, not the
# production tasks.app subdomain.
VITE_TASKS_APP_URL=https://sindustries-tasks-app-staging.fly.dev/
