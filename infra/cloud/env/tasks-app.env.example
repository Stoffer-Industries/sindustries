# tasks-app.env.example — staging build-time env.
#
# Like mission-control.env.example: passed to `fly deploy` as
# `--build-arg` and baked into the SPA bundle. No runtime env-var
# override — Vite inlines at build time.
#
# Usage:
#   fly deploy \
#     --config infra/cloud/fly/tasks-app.fly.toml \
#     --build-arg VITE_TASKS_API_BASE_URL=$(awk -F= '/^VITE_TASKS_API_BASE_URL/{print $2}' infra/cloud/env/tasks-app.env.example) \
#     --build-arg VITE_SHELL_ORIGIN=$(awk -F= '/^VITE_SHELL_ORIGIN/{print $2}' infra/cloud/env/tasks-app.env.example)

# Staging Tasks API base URL — read by apps/tasks/src/tasksApi.ts.
VITE_TASKS_API_BASE_URL=https://sindustries-tasks-api-staging.fly.dev/api/v1

# Staging Mission Control origin — read by apps/tasks/src/main.jsx.
# The Tasks app uses this to allowlist postMessage senders from the
# iframe parent (Mission Control). Set to the Mission Control staging
# Fly URL so the embed handshake validates correctly.
VITE_SHELL_ORIGIN=https://sindustries-mission-control-staging.fly.dev
