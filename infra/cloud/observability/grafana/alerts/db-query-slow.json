{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "db-query-slow",
      "folder": "SIndustries/Database",
      "interval": "1m",
      "rules": [
        {
          "uid": "sindustries-db-query-slow",
          "title": "db-query-slow",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "histogram_quantile(0.95, sum by (app, le) (rate(sindustries_db_query_duration_seconds_bucket[5m])))",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "max",
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": { "type": "gt", "params": [0.5] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "p95 SELECT 1 round-trip > 500ms for 5m",
            "description": "p95 sindustries_db_query_duration_seconds exceeded 500ms over the last 5 minutes (worst app). Operator: Quinn. Response: see docs/systems/observability.md 'Alert ownership' table.",
            "owner": "Quinn",
            "severity": "warn"
          },
          "labels": {
            "alert": "db-query-slow",
            "severity": "warn",
            "owner": "Quinn"
          }
        }
      ]
    }
  ]
}
