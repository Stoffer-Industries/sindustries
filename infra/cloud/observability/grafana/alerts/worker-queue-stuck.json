{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "worker-queue-stuck",
      "folder": "SIndustries/Performance",
      "interval": "1m",
      "rules": [
        {
          "uid": "sindustries-worker-queue-stuck",
          "title": "worker-queue-stuck",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "max(sindustries_queue_ready) by (queue)",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "max",
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": { "type": "gt", "params": [100] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "worker queue ready depth > 100 for 5m",
            "description": "sindustries_queue_ready crossed 100 over the last 5 minutes (worst queue). Operator: Quinn. Response: see docs/systems/observability.md 'Alert ownership' table.",
            "owner": "Quinn",
            "severity": "warn"
          },
          "labels": {
            "alert": "worker-queue-stuck",
            "severity": "warn",
            "owner": "Quinn"
          }
        }
      ]
    }
  ]
}
