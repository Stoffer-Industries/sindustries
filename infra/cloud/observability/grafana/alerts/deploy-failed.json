{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "deploy-failed",
      "folder": "SIndustries/CI",
      "interval": "1m",
      "rules": [
        {
          "uid": "sindustries-deploy-failed",
          "title": "deploy-failed",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "increase(sindustries_deploy_failed_total[10m])",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": { "type": "gt", "params": [0] },
                    "operator": { "type": "and" },
                    "query": { "params": ["B"] },
                    "reducer": { "type": "last", "params": [] }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Deploy workflow failed",
            "description": "sindustries_deploy_failed_total increased over the last 10 minutes. Operator: Quinn. Response: see docs/systems/observability.md 'Alert ownership' table.",
            "owner": "Quinn",
            "severity": "warn"
          },
          "labels": {
            "alert": "deploy-failed",
            "severity": "warn",
            "owner": "Quinn"
          }
        }
      ]
    }
  ]
}
