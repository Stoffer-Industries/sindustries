{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "tasks-api-5xx-spike",
      "folder": "SIndustries/Performance",
      "interval": "1m",
      "rules": [
        {
          "uid": "sindustries-tasks-api-5xx-spike",
          "title": "tasks-api-5xx-spike",
          "condition": "E",
          "data": [
            {
              "refId": "A",
              "queryType": "",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"tasks-api\",http_status_code=~\"5..\"}[5m]))",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "queryType": "",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "prometheus",
              "model": {
                "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"tasks-api\"}[5m]))",
                "instant": true,
                "refId": "B"
              }
            },
            {
              "refId": "C",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "math",
                "expression": "$A / $B",
                "refId": "C"
              }
            },
            {
              "refId": "D",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "reduce",
                "expression": "C",
                "reducer": "last",
                "refId": "D"
              }
            },
            {
              "refId": "E",
              "queryType": "",
              "relativeTimeRange": { "from": 0, "to": 0 },
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "D",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": { "type": "gt", "params": [0.05] },
                    "operator": { "type": "and" },
                    "query": { "params": ["D"] },
                    "reducer": { "type": "last", "params": [] }
                  }
                ],
                "refId": "E"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "tasks-api 5xx ratio > 5% over 5m",
            "description": "5xx ratio on tasks-api exceeded 5% over the last 5 minutes (5xx requests / total requests). Operator: Quinn. Response: see docs/systems/observability.md 'Alert ownership' table.",
            "owner": "Quinn",
            "severity": "warn"
          },
          "labels": {
            "alert": "tasks-api-5xx-spike",
            "severity": "warn",
            "owner": "Quinn"
          }
        }
      ]
    }
  ]
}
