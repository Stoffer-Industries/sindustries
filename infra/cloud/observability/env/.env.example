# Hosted Observability — env-var contract.
#
# Live values are Quinn-owned and live in Fly.io secrets on the
# health-probe app (and on each app that needs to export to the hosted
# Grafana). This file lists NAMES only with redacted placeholders.
#
# The matching `infra/cloud/observability/.env.local` (NEVER commit) is
# read by bootstrap-observability.sh during the one-time provision of
# the hosted Grafana organisation.
#
# Cross-references:
#   docs/systems/observability.md                          — durable ownership handover
#   docs/specs/hosted-observability-migration-alerts-tech-design.md — design + AC verification
#   infra/cloud/observability/README.md                    — operator index
#   infra/cloud/observability/health-probe/                — runtime target list (consumed here)

# ---------------------------------------------------------------------------
# Grafana Cloud (Quinn-owned; one-time org creation in the closest region to
# Fly.io `syd`).
# ---------------------------------------------------------------------------
# OTLP endpoint — the URL the SDK and the health-probe push traces + metrics
# to. Format on Grafana Cloud tenants: a bare host whose OTLP paths live
# under `/otlp/v1/{traces,metrics,logs}`. The single-host rewriter in
# `apps/gymtrack/api/telemetry.js` `lokiPushUrl()` only handles a
# `/v1[-suffix]`-terminated base safely; on the real bare-host shape it
# returns null and the relay surfaces a 502 `misconfigured_loki_endpoint`.
# The health-probe + OTel SDK both POST to `<base>/otlp/v1/{traces,metrics}`
# directly, so this base ends in either `/v1/traces` form (rewriter-safe)
# or is left bare (rewriter refused; relay needs the LOKI override).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-region.grafana.net/v1/

# Loki HTTP push URL — the URL the GymTrack browser telemetry relay
# (apps/gymtrack/api/telemetry.js) posts sanitised browser events to.
# REQUIRED on Grafana Cloud tenants: the OTLP gateway host and the Loki
# push API live on different hosts there (logs-prod-<stack>.grafana.net).
# Without this override the relay's OTLP-derivation returns null on the
# real tenant shape and the browser event is lost. Format: a full URL
# ending in `/loki/api/v1/push`.
GRAFANA_CLOUD_LOKI_ENDPOINT=https://logs-prod-<stack>.grafana.net/loki/api/v1/push

# OTLP headers — Basic auth over `<instance_id>:<access_policy_token>`.
# Quote values containing spaces so sourcing this file remains valid Bash.
GRAFANA_CLOUD_OTLP_HEADERS="Authorization=Basic <redacted-base64>"

# Grafana Cloud provisioning API — used by bootstrap-observability.sh to
# upload dashboards and alert rules. Use a service-account token with the
# required folder, dashboard, datasource-read, and alert-rule permissions.
GRAFANA_CLOUD_PROVISIONING_AUTH="Bearer <redacted-service-account-token>"

# Grafana instance base URL used for the provisioning HTTP API.
# This is the stack URL (for example https://example.grafana.net), not the
# Prometheus remote-write/query URL.
GRAFANA_CLOUD_INSTANCE_URL=https://example.grafana.net

# Loki push endpoint — OPTIONAL, and required on multi-host tenants.
# Grafana Cloud serves OTLP from an `otlp-prod-*` gateway but the Loki HTTP
# push API from a separate `logs-prod-*` host, so a single OTLP base cannot
# describe both. Set this to the tenant's own Loki datasource URL when the
# two hosts differ; the value is used verbatim as the push endpoint.
# GRAFANA_CLOUD_LOKI_ENDPOINT=https://logs-prod-<stack>-prod-<region>.grafana.net/loki/api/v1/push

# GymTrack telemetry relay — OPTIONAL.
# The base URL of the deployed GymTrack SPA (no trailing path). `validate`
# probes <base>/api/telemetry and checks that it is a real Vercel function
# rather than the SPA catch-all serving index.html.
# GYMTRACK_RELAY_BASE_URL=https://<gymtrack-host>

# ---------------------------------------------------------------------------
# Endpoints probed by `bootstrap-observability.sh validate`.
#
# `validate` proves the vars above are populated, then resolves each endpoint
# below with a read-only reachability probe and names any var that points
# somewhere unusable. Set PROBE_SKIP_NETWORK=1 to skip the probes.
#
<!-- BEGIN generated: bootstrap-observability endpoint table — edit infra/cloud/observability/bootstrap-observability.sh instead -->
| Endpoint id | Env var | Role | Required shape |
| --- | --- | --- | --- |
| `grafana_instance` | `GRAFANA_CLOUD_INSTANCE_URL` | `grafana-instance` | https://<stack>.grafana.net — stack base URL only, no trailing path |
| `otlp_endpoint` | `GRAFANA_CLOUD_OTLP_ENDPOINT` | `otlp-endpoint` | https://<host> (Grafana Cloud serves OTLP under /otlp/v1/*) or https://<host>/v1/ |
| `loki_push` | `GRAFANA_CLOUD_LOKI_ENDPOINT` | `loki-push-endpoint` | OPTIONAL — https://<logs-host>/loki/api/v1/push — set on multi-host tenants, where Loki push is a different host from OTLP |
| `gymtrack_relay` | `GYMTRACK_RELAY_BASE_URL` | `gymtrack-telemetry-relay` | OPTIONAL — https://<gymtrack-host> — SPA base URL, no trailing path; validate probes <base>/api/telemetry |
| `fly_api` | `(fixed — no env var)` | `fly-api` | https://api.fly.io/ — no path, no credentials in the URL |
<!-- END generated: bootstrap-observability endpoint table -->
#
# Status codes `validate` reads (probes are unauthenticated, so 401/302/405
# mean "correctly configured" and pass):
#   200-2xx  reachable, no auth required          pass
#   401/403  host + path exist, auth required     pass
#   302/303  instance auth wall                    pass
#   405      path exists, POST-only (Loki push)    pass
#   404      path absent — endpoint shape is wrong FAIL
#   000      no response (DNS / TLS / timeout)     FAIL
#   530      gateway origin failure                FAIL
#   other 5xx origin error                         FAIL

# ---------------------------------------------------------------------------
# Service-side OTEL wiring (Quinn-owned; set per Fly app).
#   OTEL_EXPORTER_OTLP_ENDPOINT     — defaults to the local OTel Collector
#                                       when unset, so the dev experience
#                                       is unchanged.
#   OTEL_EXPORTER_OTLP_HEADERS      — same default behaviour.
#   OTEL_RESOURCE_ATTRIBUTES        — adds deployment.environment=staging
#                                       for the Grafana Cloud stamp.
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-region.grafana.net/v1/
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <redacted-base64>"
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging

# ---------------------------------------------------------------------------
# Health probe — target lists (Quinn-owned; set as Fly secrets on the
# health-probe app).
#
# Format: comma-separated <label>=<value> pairs. Empty entries are skipped.
# ---------------------------------------------------------------------------

# Postgres targets — one series per `app` label.
HEALTH_PROBE_DATABASES=tasks-api=postgres://<user>:<password>@<host>:5432/<db>,budget-api=postgres://<user>:<password>@<host>:5432/<db>

# Fly app health endpoints — one series per `app` label.
HEALTH_PROBE_FLY_APPS=tasks-api=https://<fly-app>.fly.dev/health,budget-api=https://<fly-app>.fly.dev/health

# Redis targets — one series per `app` label.
HEALTH_PROBE_REDIS=content-scheduler=rediss://default:<password>@<host>:6379

# Probe timeout per target in milliseconds. Defaults to 5000.
HEALTH_PROBE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Bootstrap script (Quinn-owned; read from infra/cloud/observability/.env.local
# by bootstrap-observability.sh, never committed).
# ---------------------------------------------------------------------------

# Fly API token used by the bootstrap script to set Fly secrets and create the
# health-probe app. Format: flyctl auth token.
# FLY_API_TOKEN=<redacted>

# Fly organisation slug (sindustries-staging).
# FLY_ORG=sindustries-staging
