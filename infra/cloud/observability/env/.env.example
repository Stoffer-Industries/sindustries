# Hosted observability env-var contract (redacted)
#
# This file documents the env-var NAMES that hosted observability tooling reads.
# Live VALUES are operator-owned and never committed. Bootstrap them with:
#
#   fly secrets set --app <app-name> KEY=value
#
# or via the bootstrap script at infra/cloud/observability/bootstrap-observability.sh
# (added in a follow-on PR). All Grafana Cloud + Slack webhook values come from
# Quinn's local infra/cloud/observability/.env.local and never enter the repo.
#
# Mirrors the platform-wide env contract documented in
# docs/systems/observability.md.

# ---------- Grafana Cloud OTLP endpoint ----------
# OTLP/HTTP base URL. Read by packages/otel-node's OTLPTraceExporter +
# OTLPMetricExporter via the OTel SDK's built-in OTEL_EXPORTER_OTLP_ENDPOINT.
# Format: https://otlp-gateway-<region>.grafana.cloud
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP headers. Read via OTEL_EXPORTER_OTLP_HEADERS. Format:
#   Authorization=Basic <base64(instance_id:api_key)>
# The api_key is a Grafana Cloud API token with `MetricsPublisher` +
# `TracesPublisher` scopes (NOT a stack admin token).
OTEL_EXPORTER_OTLP_HEADERS=

# Service identification (read by packages/otel-node/src/index.ts).
# Set per Fly app via fly secrets.
OTEL_SERVICE_NAME=
OTEL_SERVICE_NAMESPACE=sindustries
OTEL_ENVIRONMENT=

# Resource attributes. Read via OTEL_RESOURCE_ATTRIBUTES. Appends
# deployment.environment=staging|production for hosted dashboard filters.
OTEL_RESOURCE_ATTRIBUTES=

# ---------- Health probe service ----------
# Postgres connection strings (one per app that the probe checks).
# Format: postgres://user:pass@host:port/db?sslmode=require
TASKS_API_DATABASE_URL=
BUDGET_API_DATABASE_URL=

# Upstash Redis URL. Used by the probe to PING the queue.
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Per-app health URLs. The probe GETs each URL on a 30s interval and emits
# sindustries_fly_app_health{app=<name>}={0,1}.
TASKS_API_HEALTH_URL=https://tasks-api-staging.fly.dev/health
BUDGET_API_HEALTH_URL=https://budget-api-staging.fly.dev/health
AUTO_POST_WORKER_HEALTH_URL=https://auto-post-worker-staging.fly.dev/health

# Probe's own port. Fly http_service block listens on this.
PORT=8080

# ---------- Grafana Cloud provisioning (used by bootstrap script) ----------
# API base URL for the provisioning API. Format:
#   https://<org>.grafana.net/api
GRAFANA_CLOUD_API_URL=
# Service account token with `dashboards:write` + `alerting:write` scopes.
GRAFANA_CLOUD_API_TOKEN=

# ---------- Slack webhook routing (one per alert channel) ----------
# Each webhook URL is a Slack Incoming Webhook for the corresponding channel.
# Alert routing lives in infra/cloud/observability/grafana/alerts/ (future PR).
SLACK_WEBHOOK_P1_URL=     # #sindustries-p1
SLACK_WEBHOOK_P2_URL=     # #sindustries-p2
SLACK_WEBHOOK_DEPLOY_URL= # #sindustries-deploy
SLACK_WEBHOOK_BILLING_URL= # #sindustries-billing
