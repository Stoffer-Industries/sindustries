#!/usr/bin/env bash
# bin/deploy — operator-facing wrapper around `fly deploy` for the SIndustries
# staging cluster (task 2850c5ac, cloud-staging-environment).
#
# This script exists so the staging deploy interface is exercisable from a
# laptop by a human operator (Quinn / Tom) **and** from automation that
# already has flyctl authenticated. It is **not** a replacement for the
# reusable `deploy-staging-<service>.yml` GitHub Actions workflows — those
# remain the canonical deploy path for main-branch changes. The bin/ scripts
# are for ad-hoc canaries, rehearsal, and incident-time hotfixes.
#
# Per the cloud-staging-environment tech design:
# - pin an immutable image / commit SHA — `latest` is forbidden
# - wait for rollout (canary strategy, 10-minute timeout)
# - print non-secret deployment identifiers (app, version, machine IDs)
# - refuse to run unless the caller passes an explicit service name
#
# Usage:
#   infra/cloud/bin/deploy <service> [--image <registry/repo:tag>] [--dry-run]
#
# Where <service> is one of: tasks-api, budget-api, auto-post-worker.
#
# Required environment:
#   FLY_API_TOKEN   — Fly.io API token with deploy rights on the staging
#                     organization. Quinn-owned. Never logged.
#
# Exit codes:
#   0  deploy completed, rollout healthy, smoke check (where applicable) green
#   1  invalid usage (bad service, missing --image, etc.)
#   2  preflight failed (flyctl missing, FLY_API_TOKEN missing, app missing)
#   3  fly deploy / canary failed
#   4  post-deploy smoke check failed

set -euo pipefail

# bin/ -> cloud/ -> infra/ -> repo root (3 levels up)
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
# Fallback for non-git checkouts where the relative walk could go weird.
if command -v git >/dev/null 2>&1 && [[ -d "$REPO_ROOT/.git" ]]; then
  REPO_ROOT="$(git -C "$REPO_ROOT" rev-parse --show-toplevel)"
fi

# ---------- service mapping -------------------------------------------------

declare -A FLY_APP_FOR=(
  [tasks-api]="sindustries-tasks-api-staging"
  [budget-api]="sindustries-budget-api-staging"
  [auto-post-worker]="sindustries-auto-post-worker-staging"
)
declare -A FLY_CONFIG_FOR=(
  [tasks-api]="infra/cloud/fly/tasks-api.fly.toml"
  [budget-api]="infra/cloud/fly/budget-api.fly.toml"
  [auto-post-worker]="infra/cloud/fly/auto-post-worker.fly.toml"
)
declare -A FLY_HEALTH_URL_FOR=(
  [tasks-api]="https://sindustries-tasks-api-staging.fly.dev/health"
  [budget-api]="https://sindustries-budget-api-staging.fly.dev/health"
  [auto-post-worker]=""  # no HTTP route; smoke check is the worker startup log
)

# ---------- argument parsing ------------------------------------------------

SERVICE=""
IMAGE=""
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image)
      [[ $# -ge 2 ]] || { echo "ERROR: --image requires an argument" >&2; exit 1; }
      IMAGE="$2"; shift 2 ;;
    --dry-run)
      DRY_RUN=1; shift ;;
    --help|-h)
      sed -n '2,32p' "$0"; exit 0 ;;
    -*)
      echo "ERROR: unknown flag: $1" >&2; exit 1 ;;
    *)
      if [[ -n "$SERVICE" ]]; then
        echo "ERROR: only one service argument is accepted (got '$SERVICE' and '$1')" >&2
        exit 1
      fi
      SERVICE="$1"; shift ;;
  esac
done

if [[ -z "$SERVICE" ]]; then
  echo "ERROR: service argument required (one of: ${!FLY_APP_FOR[*]})" >&2
  exit 1
fi
if [[ -z "${FLY_APP_FOR[$SERVICE]:-}" ]]; then
  echo "ERROR: unknown service '$SERVICE' (must be one of: ${!FLY_APP_FOR[*]})" >&2
  exit 1
fi

FLY_APP="${FLY_APP_FOR[$SERVICE]}"
FLY_CONFIG="${FLY_CONFIG_FOR[$SERVICE]}"
HEALTH_URL="${FLY_HEALTH_URL_FOR[$SERVICE]}"

# ---------- preflight -------------------------------------------------------

info() { printf '\033[36m[deploy]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[deploy]\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[31m[deploy]\033[0m %s\n' "$*" >&2; exit "${2:-1}"; }

command -v flyctl >/dev/null 2>&1 || fail "flyctl not on PATH; install via https://fly.io/docs/hands-on/install-flyctl/" 2

# FLY_API_TOKEN must be present in the caller env (Quinn-owned). We never
# echo it. We do explicitly check non-empty so a half-populated .env.local
# fails fast with a clear pointer.
if [[ -z "${FLY_API_TOKEN:-}" ]]; then
  fail "FLY_API_TOKEN is not set. Source ~/.openclaw/.env (or your operator .env.local) and retry." 2
fi
export FLY_API_TOKEN

cd "$REPO_ROOT"
[[ -f "$FLY_CONFIG" ]] || fail "fly.toml not found: $FLY_CONFIG" 2

info "validating $FLY_CONFIG"
flyctl config validate --config "$FLY_CONFIG" || fail "fly.toml validation failed" 3

info "checking that $FLY_APP exists"
if ! flyctl apps list --json 2>/dev/null | grep -q "\"Name\":\"$FLY_APP\""; then
  fail "Fly app '$FLY_APP' is not provisioned; run infra/cloud/scripts/bootstrap-staging.sh first" 2
fi

# ---------- build the deploy command ---------------------------------------

DEPLOY_ARGS=(
  deploy
  --config "$FLY_CONFIG"
  --strategy canary
  --wait-timeout 600
)
if [[ -n "$IMAGE" ]]; then
  # Pin to the immutable image tag the caller supplied. Refuse anything
  # that looks like a moving tag (`latest`, empty).
  case "$IMAGE" in
    *:latest|"")
      fail "image must be pinned to an immutable tag (got '$IMAGE'); refusing :latest" 1 ;;
  esac
  DEPLOY_ARGS+=(--image "$IMAGE")
  info "deploying $FLY_APP with pinned image $IMAGE"
else
  info "deploying $FLY_APP from local source (no --image override)"
fi

# ---------- dry-run path --------------------------------------------------

if [[ "$DRY_RUN" -eq 1 ]]; then
  printf "DRY-RUN flyctl"; printf ' %q' "${DEPLOY_ARGS[@]}"; printf '\n'
  printf "DRY-RUN would tail %s after deploy\n" "${HEALTH_URL:-flyctl logs --app $FLY_APP}"
  exit 0
fi

# ---------- execute deploy -------------------------------------------------

info "starting canary deploy"
flyctl "${DEPLOY_ARGS[@]}" || fail "flyctl deploy failed for $FLY_APP" 3

# ---------- post-deploy identifiers ----------------------------------------

VERSION="$(flyctl releases --app "$FLY_APP" --json 2>/dev/null \
  | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r[0]["Version"] if r else "unknown")')"

MACHINES="$(flyctl machines list --app "$FLY_APP" --json 2>/dev/null \
  | python3 -c 'import json,sys; ms=json.load(sys.stdin); print(",".join(m["id"] for m in ms))')"

info "deployment complete"
cat <<EOF
app:    $FLY_APP
version: $VERSION
machines: ${MACHINES:-none}
EOF

# ---------- post-deploy smoke check ----------------------------------------

if [[ -n "$HEALTH_URL" ]]; then
  info "smoke check: GET $HEALTH_URL"
  if curl --fail --silent --show-error --max-time 10 "$HEALTH_URL" >/dev/null; then
    info "smoke OK"
  else
    fail "smoke check failed for $HEALTH_URL — check fly logs --app $FLY_APP" 4
  fi
else
  info "smoke check: fly logs --app $FLY_APP (worker startup line)"
  # No HTTP route for the auto-post worker. The smoke check is the worker's
  # structured startup log line ("[content-scheduler-worker] starting
  # (adapter=bullmq)"). We tail logs for up to 60 seconds.
  DEADLINE=$((SECONDS + 60))
  SAW_STARTUP=0
  while [[ $SECONDS -lt $DEADLINE ]]; do
    if flyctl logs --app "$FLY_APP" --no-tail 2>/dev/null \
        | grep -q '\[content-scheduler-worker\] starting'; then
      SAW_STARTUP=1
      break
    fi
    sleep 5
  done
  if [[ "$SAW_STARTUP" -eq 1 ]]; then
    info "smoke OK (worker startup log observed)"
  else
    fail "worker startup log not observed within 60s — check fly logs --app $FLY_APP" 4
  fi
fi

exit 0