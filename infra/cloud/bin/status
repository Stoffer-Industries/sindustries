#!/usr/bin/env bash
# bin/status — operator-facing status check for the SIndustries staging
# cluster (task 2850c5ac, cloud-staging-environment).
#
# Prints, per service:
#   - current Fly app name + URL
#   - latest release version + creation timestamp
#   - process types (services defined in fly.toml vs running)
#   - machine IDs, regions, and states
#
# By default reports all four staging services. Pass a service name to
# scope the report. The --json flag emits a single JSON document (one
# element per service) suitable for the staging-workflows harness or the
# failure drill evidence record.
#
# Usage:
#   infra/cloud/bin/status                    # the staging platform, human-readable
#   infra/cloud/bin/status <service>          # one service
#   infra/cloud/bin/status --json [service]   # machine-readable
#
# STAGING IS ONE APP (task 219fb673, cutover 2026-11-07). The four
# per-service Fly apps were destroyed at the cutover and staging now runs
# the consolidated platform app, which hosts all four services as
# supervisor children. The four service names are kept as ALIASES so
# operator muscle memory and the runbooks keep working: they all resolve
# to the same Fly app, and each one additionally reports the state of ITS
# child inside that app, read from the supervisor's status endpoint.
#
# The per-child state is read from the supervisor's own /__status payload
# (the same payload Fly's http_check targets). Without it the report could
# only say "the Machine is up", which after the consolidation is NOT the
# same statement as "tasks-api is serving".
#
# Required environment:
#   FLY_API_TOKEN   — Fly.io API token (Quinn-owned).
#
# Optional environment:
#   FLY_STATUS_USE_AMBIENT_PROXY=1
#                    — keep the operator shell's proxy variables for the
#                      flyctl call. By default the script calls flyctl with
#                      DIRECT egress (the proxy variables are unset), so a
#                      TLS-intercepting proxy in the agent shell cannot make
#                      the report fail for a reason that has nothing to do
#                      with the platform. Set this on a host whose only
#                      egress is a proxy.
#
# Exit codes:
#   0  all targeted services report a non-empty machine list and the
#      expected process types
#   1  invalid usage
#   2  preflight failed (flyctl missing, FLY_API_TOKEN missing, app missing)
#   3  one or more services have zero machines or a missing process type

set -euo pipefail

# bin/ -> cloud/ -> infra/ -> repo root (3 levels up)
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
if command -v git >/dev/null 2>&1 && [[ -d "$REPO_ROOT/.git" ]]; then
  REPO_ROOT="$(git -C "$REPO_ROOT" rev-parse --show-toplevel)"
fi

# The shared credential redactor. Every operator surface that shows flyctl
# output masks credentials with this ONE module, so the two surfaces
# cannot drift apart (they used to: this script's own sed rule missed URL
# and DSN credentials, JSON credential fields and Authorization headers,
# so a `postgres://` DSN printed in the clear).
REDACT_OUTPUT="$REPO_ROOT/infra/cloud/platform/redact-output.mjs"

declare -A FLY_APP_FOR=(
  [tasks-api]="sindustries-platform-staging"
  [budget-api]="sindustries-platform-staging"
  [content-scheduler-api]="sindustries-platform-staging"
  [auto-post-worker]="sindustries-platform-staging"
  [platform]="sindustries-platform-staging"
)

# The supervisor's status endpoint, served through the platform's router.
# It reports the per-child state (pid, state, restarts, exit code, RSS)
# that the Fly-level status cannot see any more.
PLATFORM_STATUS_URL="https://sindustries-platform-staging.fly.dev/__status"

# Expected process types come from the matching fly.toml. We hardcode them
# here so a missing process type is detectable without parsing TOML. If
# these drift from infra/cloud/fly/*.fly.toml, the relevant test must be
# updated.
#
# After the consolidation there is ONE Fly process group: the supervisor's,
# named "platform". The four services are children inside that process
# group, not Fly process types of their own, so every service name
# expects the platform's process type. A child that is not running is
# reported through the supervisor payload, not through Fly.
declare -A EXPECTED_PROCESS_TYPES=(
  [tasks-api]="platform"
  [budget-api]="platform"
  [content-scheduler-api]="platform"
  [auto-post-worker]="platform"
  [platform]="platform"
)

# ---------- argument parsing ------------------------------------------------

JSON=0
TARGETS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --help|-h)
      sed -n '2,28p' "$0"; exit 0 ;;
    -*)
      echo "ERROR: unknown flag: $1" >&2; exit 1 ;;
    *)
      TARGETS+=("$1"); shift ;;
  esac
done

if [[ ${#TARGETS[@]} -eq 0 ]]; then
  # Staging is ONE Fly app now. Reporting it once (rather than five
  # times, once per alias) keeps the report a statement about the app,
  # and the per-child state is carried in the payload.
  TARGETS+=(platform)
fi

for s in "${TARGETS[@]}"; do
  if [[ -z "${FLY_APP_FOR[$s]:-}" ]]; then
    echo "ERROR: unknown service '$s' (must be one of: ${!FLY_APP_FOR[*]})" >&2
    exit 1
  fi
done

# ---------- preflight -------------------------------------------------------

info() { [[ "$JSON" -eq 1 ]] || printf '\033[36m[status]\033[0m %s\n' "$*"; }
warn() { [[ "$JSON" -eq 1 ]] || printf '\033[33m[status]\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[31m[status]\033[0m %s\n' "$*" >&2; exit "${2:-1}"; }

# Redact anything credential-shaped before flyctl's stderr is shown to an
# operator. Operator output ends up pasted into task comments on a public
# repo, so a token must never ride along with the diagnostic.
#
# The rules live in `infra/cloud/platform/redact-output.mjs`, the same
# module the platform provisioning script uses. That module covers URL and
# DSN credentials, JSON credential fields, `NAME=value` assignments and
# the Bearer/Basic/FlyV1 authorization header forms, and it keeps closing
# punctuation OUTSIDE the masked value so a diagnostic does not lose
# characters the operator is reading.
sanitize_fly_error() {
  local out
  if ! out="$(printf '%s' "$1" | node "$REDACT_OUTPUT" 2>/dev/null)"; then
    # Fail closed: if the redactor cannot run, show nothing that might
    # carry a credential rather than the raw stderr.
    out="(flyctl's error could not be shown safely)"
  fi
  printf '%s' "$out"
}

# The flyctl call runs with DIRECT egress. An ambient TLS-intercepting
# proxy makes flyctl fail with `x509: "api.fly.io" certificate is not
# trusted` while curl and openssl verify the same host cleanly: the cause
# is the operator's shell environment, not the platform this script
# reports on. The proxy policy lives here, in one place, the same way
# `agents/lib/github-cli.sh` keeps it for `gh`.
#
# The CA-bundle variables go with them: on this host the ambient
# SSL_CERT_FILE points at the egress proxy's trust bundle, so a DIRECT
# connection would verify Fly's certificate against the proxy's CA and
# fail the same way. Unsetting them lets Go use the system trust store,
# which is what a direct connection needs.
#
# Escape hatch: on a host whose ONLY egress is a proxy — or whose root CA
# lives only in the ambient bundle — set FLY_STATUS_USE_AMBIENT_PROXY=1
# and the operator's environment is passed through untouched.
run_flyctl() {
  if [[ "${FLY_STATUS_USE_AMBIENT_PROXY:-0}" == "1" ]]; then
    flyctl "$@"
  else
    env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
        -u SSL_CERT_FILE -u SSL_CERT_DIR flyctl "$@"
  fi
}

command -v flyctl >/dev/null 2>&1 || fail "flyctl not on PATH" 2
command -v python3 >/dev/null 2>&1 || fail "python3 not on PATH (needed for JSON shaping)" 2
command -v node >/dev/null 2>&1 || fail "node not on PATH (needed to redact flyctl's output)" 2
[[ -f "$REDACT_OUTPUT" ]] || fail "credential redactor not found at $REDACT_OUTPUT" 2
if [[ -z "${FLY_API_TOKEN:-}" ]]; then
  fail "FLY_API_TOKEN is not set. Source ~/.openclaw/.env (or operator .env.local) and retry." 2
fi
export FLY_API_TOKEN

# ---------- collect per-service data ---------------------------------------

# Emit either a human-readable block or one JSON object per service.
declare -a JSON_OBJECTS=()
ANY_DEGRADED=0

# The supervisor's status payload, fetched ONCE and shared by every
# target. It is the only place the per-child state is visible after the
# consolidation, so a failure to read it is reported rather than hidden:
# a missing payload means "unknown", not "healthy".
SUPERVISOR_JSON=""
if command -v curl >/dev/null 2>&1; then
  SUPERVISOR_JSON="$(curl --fail --silent --show-error --max-time 10 "$PLATFORM_STATUS_URL" 2>/dev/null || true)"
fi
if [[ -z "$SUPERVISOR_JSON" ]]; then
  warn "could not read the supervisor status from $PLATFORM_STATUS_URL; per-child state will be reported as unknown"
fi

for service in "${TARGETS[@]}"; do
  FLY_APP="${FLY_APP_FOR[$service]}"
  EXPECTED_PT="${EXPECTED_PROCESS_TYPES[$service]}"

  info "checking $FLY_APP"

  # `fly status --json` returns the app status envelope: name, status,
  # deployed, version, machines, and (on some versions) release and
  # services. The envelope's shape CHANGED between flyctl releases — the
  # live 0.4.111 envelope has no "Services", no "ProcessTypes" and no
  # "Release" key, and its machine fields are lowercase — so the parsing
  # below accepts every shape the tool has shipped.
  #
  # flyctl's stderr is captured rather than discarded: a TLS, credential
  # or auth failure is otherwise indistinguishable from a missing app.
  FLY_ERR_FILE="$(mktemp)"
  if ! APP_JSON="$(run_flyctl status --app "$FLY_APP" --json 2>"$FLY_ERR_FILE")"; then
    FLY_ERR="$(sanitize_fly_error "$(cat "$FLY_ERR_FILE")")"
    rm -f "$FLY_ERR_FILE"
    # A certificate failure means the operator's host could not verify
    # Fly's certificate. The call already ran with direct egress and the
    # system trust store, so the ambient proxy is not the cause any more
    # — but on a host that has no direct route at all, or whose root CA
    # lives only in the ambient bundle, the operator needs to know that
    # the escape hatch exists.
    case "$FLY_ERR" in
      *"certificate is not trusted"*|*"x509:"*)
        FLY_ERR="$FLY_ERR - this host could not verify Fly's certificate; flyctl ran with direct egress (proxy variables unset) — if your host reaches the internet only through a proxy, set FLY_STATUS_USE_AMBIENT_PROXY=1 (see infra/cloud/README.md)"
        ;;
    esac
    fail "flyctl status failed for $FLY_APP${FLY_ERR:+ — $FLY_ERR}" 2
  fi
  rm -f "$FLY_ERR_FILE"

  # Shape into the report we want.
  REPORT="$(APP_JSON="$APP_JSON" EXPECTED_PT="$EXPECTED_PT" SERVICE="$service" FLY_APP="$FLY_APP" SUPERVISOR_JSON="$SUPERVISOR_JSON" \
    python3 - <<'PY'
import json, os, sys
app = json.loads(os.environ["APP_JSON"])
expected_pt = os.environ["EXPECTED_PT"]
service = os.environ["SERVICE"]
fly_app = os.environ["FLY_APP"]

machines = []
machine_process_groups = []
for m in app.get("Machines") or []:
    # flyctl has shipped both casings: the live 0.4.111 envelope uses
    # lowercase machine keys ("id", "name", "state", "region").
    machines.append({
        "id": m.get("ID") or m.get("id") or "",
        "region": m.get("Region") or m.get("region") or "",
        "state": m.get("State") or m.get("state") or "",
        "name": m.get("Name") or m.get("name") or "",
    })
    # The process group a machine actually runs. Fly injects it into the
    # machine env as FLY_PROCESS_GROUP. This is the ONLY process-type
    # signal in the live envelope (it carries no "Services"/"ProcessTypes"
    # key), so it is read here. ONLY this one variable is read, so no
    # other env value can reach the report.
    config = m.get("config") if isinstance(m.get("config"), dict) else {}
    env = config.get("env") if isinstance(config.get("env"), dict) else {}
    group = env.get("FLY_PROCESS_GROUP")
    if group:
        machine_process_groups.append(str(group))

services_running = []
for svc in app.get("Services") or []:
    services_running.append({
        "protocol": svc.get("Protocol") or "",
        "port": svc.get("Port"),
        "processTypes": [
            ps.get("Type") or ps.get("type") or ""
            for ps in (svc.get("Ports") or [])
        ],
    })

# `fly status --json` has shipped three process-type shapes:
#   1. `app["Services"][i]["Ports"][j]["Type"]` (older releases)
#   2. `app["ProcessTypes"][i]["Type"]` (some releases)
#   3. neither — the live 0.4.111 envelope carries no process-type key at
#      all, and the running groups are readable only from the machines'
#      own FLY_PROCESS_GROUP env.
# All three are read, so the report does not depend on which flyctl is
# installed.
process_types_flat = set()
process_type_sources = set()
for svc in services_running:
    for pt in svc["processTypes"]:
        if pt:
            process_types_flat.add(pt)
            process_type_sources.add("services")
for pt in app.get("ProcessTypes") or []:
    name = pt.get("Type") or pt.get("type") or pt.get("Name") or pt.get("name") or ""
    if name:
        process_types_flat.add(name)
        process_type_sources.add("processTypes")
for group in machine_process_groups:
    process_types_flat.add(group)
    process_type_sources.add("machine-env")

expected_present = expected_pt in process_types_flat
process_types_detected = bool(process_types_flat)

# The release version moved too: some flyctl releases nest it under
# "Release" -> {"Version": N}, the live one puts a flat "Version": N at
# the top level of the envelope.
release = app.get("Release") if isinstance(app.get("Release"), dict) else {}
version = release.get("Version")
if version is None:
    version = app.get("Version")

# The supervisor payload is the only per-child signal after the
# consolidation. It is optional: when it cannot be read, the child state
# is reported as "unknown" and the report is marked degraded, because
# "the Machine is up" is not the same statement as "the service is
# serving".
supervisor = {}
supervisor_raw = os.environ.get("SUPERVISOR_JSON") or ""
if supervisor_raw:
    try:
        supervisor = json.loads(supervisor_raw)
    except json.JSONDecodeError:
        supervisor = {}

children = []
for child in supervisor.get("children") or []:
    children.append({
        "name": child.get("name") or "",
        "role": child.get("role") or "",
        "state": child.get("state") or "",
        "pid": child.get("pid"),
        "port": child.get("port"),
        "restarts": child.get("restarts"),
        "exitCode": child.get("exitCode"),
        "rssKb": child.get("rssKb"),
    })

supervisor_available = bool(supervisor)
platform_ready = bool(supervisor.get("ready")) if supervisor_available else False

# The child that backs this target. "platform" is the whole app, so it
# reports every child.
child_state = None
if service != "platform":
    for child in children:
        if child["name"] == service:
            child_state = child
            break
else:
    child_state = {
        "name": "platform",
        "state": "running" if platform_ready else "not-ready",
    }

child_healthy = None
if child_state is not None:
    child_healthy = child_state["state"] == "running"
elif supervisor_available:
    # A service target with no matching child in the payload is a real
    # inconsistency, not an unknown.
    child_healthy = False

degraded = (len(machines) == 0) or (not expected_present)
if not supervisor_available:
    # The per-child state is UNKNOWN, and "unknown" is not "healthy": the
    # report says so instead of claiming a service is serving.
    degraded = True
elif child_healthy is False:
    degraded = True

out = {
    "service": service,
    "app": fly_app,
    "name": app.get("Name") or "",
    "status": app.get("Status") or "",
    "deployed": app.get("Deployed") or False,
    "version": version,
    "expectedProcessType": expected_pt,
    "processTypesRunning": sorted(process_types_flat),
    "processTypeSource": sorted(process_type_sources),
    "processTypesDetected": process_types_detected,
    "expectedProcessTypePresent": expected_present,
    "machines": machines,
    "machineCount": len(machines),
    "supervisorStatusAvailable": supervisor_available,
    "platformReady": platform_ready,
    "child": child_state,
    "childHealthy": child_healthy,
    "children": children,
    "degraded": degraded,
}
print(json.dumps(out))
PY
  )"

  if [[ "$JSON" -eq 1 ]]; then
    JSON_OBJECTS+=("$REPORT")
  else
    echo "$REPORT" | python3 -m json.tool
  fi

  if echo "$REPORT" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin)["degraded"] else 1)'; then
    ANY_DEGRADED=1
  fi
done

if [[ "$JSON" -eq 1 ]]; then
  # Emit a single JSON document. We strip the per-line break and join with
  # commas so downstream parsers see a valid JSON array.
  (
    printf '['
    for i in "${!JSON_OBJECTS[@]}"; do
      if [[ "$i" -gt 0 ]]; then printf ','; fi
      printf '%s' "${JSON_OBJECTS[$i]}"
    done
    printf ']\n'
  )
fi

if [[ "$ANY_DEGRADED" -eq 1 ]]; then
  exit 3
fi
exit 0
